<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>DestinyBone</AssemblyName>
    <RootNamespace>DestinyBone</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>CS0618;CS0649;CS0169</NoWarn>

    <!-- 游戏目录：默认本机路径，换机器时用 -p:SkulDir=... 覆盖 -->
    <SkulDir Condition="'$(SkulDir)' == ''">D:\Game\Learning\Skul</SkulDir>
    <ManagedDir>$(SkulDir)\Skul_Data\Managed</ManagedDir>
    <UnityLibDir>$(SkulDir)\2020.3.34</UnityLibDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Icon.png" LogicalName="DestinyBone.Sprites.Icon.png" />
    <EmbeddedResource Include="Resources\Thumbnail.png" LogicalName="DestinyBone.Sprites.Thumbnail.png" />
    <EmbeddedResource Include="Resources\AbilityIcon.png" LogicalName="DestinyBone.Sprites.AbilityIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(SkulDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SkulDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Plugins.Common"><HintPath>$(ManagedDir)\Plugins.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Plugins.Data"><HintPath>$(ManagedDir)\Plugins.Data.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Plugins.Singletons"><HintPath>$(ManagedDir)\Plugins.Singletons.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(UnityLibDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityLibDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(UnityLibDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(UnityLibDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(UnityLibDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(UnityLibDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(UnityLibDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
